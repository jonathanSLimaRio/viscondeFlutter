generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StoryMode {
  PARENT_NARRATOR
  CHILD_CHOOSER
}

enum StoryStepKind {
  NARRATION
  CHILD_CHOICE
  SYSTEM
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?

  passwordHash String?
  imageUrl     String?
  timezone     String   @default("UTC")
  pinHash      String?
  pinUpdatedAt DateTime?
  lastLoginAt  DateTime?

  accounts            Account[]
  sessions            Session[]
  mobileSessions      MobileSession[]
  childProfiles       ChildProfile[]
  stories             Story[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model MobileSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model ChildProfile {
  id             String   @id @default(cuid())
  userId         String
  name           String
  birthDate      DateTime
  avatarUrl      String?
  favoriteThemes String[] @default([])
  isArchived     Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories Story[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isArchived])
}

model Story {
  id               String      @id @default(cuid())
  userId           String
  childProfileId   String
  titleDraft       String
  titleFinal       String?
  theme            String
  scenario         String
  objective        String
  status           StoryStatus @default(DRAFT)
  currentMode      StoryMode   @default(PARENT_NARRATOR)
  currentStepIndex Int         @default(0)
  ageSnapshotYears Int
  startedAt        DateTime    @default(now())
  publishedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  childProfile ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  characters StoryCharacter[]
  steps      StoryStep[]
  ideaLogs   StoryIdeaLog[]

  @@index([userId, childProfileId, status])
  @@index([updatedAt])
}

model StoryCharacter {
  id        String   @id @default(cuid())
  storyId   String
  name      String
  role      String?
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
}

model StoryStep {
  id                  String       @id @default(cuid())
  storyId             String
  stepIndex           Int
  kind                StoryStepKind
  modeUsed            StoryMode
  localEventId        String
  narratorPrompt      String?
  childOptionsJson    Json?
  selectedOptionId    String?
  selectedOptionLabel String?
  narratorText        String?
  autoSavedAt         DateTime     @default(now())
  createdAt           DateTime     @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, stepIndex])
  @@index([storyId, localEventId])
  @@index([storyId, createdAt])
}

model StoryIdeaLog {
  id             String   @id @default(cuid())
  storyId        String
  stepIndex      Int?
  source         String
  safetyAdjusted Boolean  @default(false)
  promptInput    String?
  ideasJson      Json
  fallbackReason String?
  createdAt      DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model AuditEvent {
  id        String  @id @default(cuid())
  userId    String?
  action    String
  meta      Json?
  ipAddress String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, action])
  @@index([createdAt])
}
