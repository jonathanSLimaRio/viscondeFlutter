generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StoryMode {
  PARENT_NARRATOR
  CHILD_CHOOSER
}

enum StoryStepKind {
  NARRATION
  CHILD_CHOICE
  SYSTEM
}

enum StorySessionKind {
  PRESENTIAL
  REMOTE
}

enum RemoteRoomStatus {
  OPEN
  ACTIVE
  CLOSED
  EXPIRED
}

enum RemoteParticipantRole {
  HOST_PARENT
  GUEST_CHILD
}

enum RemoteParticipantStatus {
  CONNECTED
  DISCONNECTED
  LEFT
}

enum CallMode {
  NONE
  AUDIO
  VIDEO
  COOP
}

enum InteractionType {
  CHAT
  REACTION
}

enum AgeBand {
  AGE_4_5
  AGE_6_8
  AGE_9_10
}

enum VirtueSource {
  MANUAL
  AUTO
}

enum CurrencyType {
  COIN
  STAR
}

enum CatalogItemType {
  SCENARIO
  CHARACTER
  SKIN
  AVATAR
}

enum WalletReason {
  STORY_PUBLISHED
  MISSION_COMPLETED
  ACHIEVEMENT_UNLOCK
  PURCHASE_REFUND
  PURCHASE_SPEND
  BACKFILL
}

enum MissionKind {
  PUBLISH_COUNT
  PUBLISH_WITH_VIRTUE
  CONTINUE_EPISODE
}

enum MissionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum UserRole {
  USER
  ADMIN
}

enum PromptKind {
  IDEA_SYSTEM
  IDEA_FALLBACK
  NARRATOR_HINT
}

enum StoryTemplateNodeKind {
  START
  NARRATION
  CHOICE
  END
}

enum ModerationPolicy {
  BLOCK
  SANITIZE
}

enum ModerationScope {
  USER_NAME
  CHILD_NAME
  STORY_TEXT
  CHAT_TEXT
  TEMPLATE_TEXT
}

enum ModerationAction {
  BLOCK
  SANITIZE
}

enum VoiceProfileStatus {
  PENDING
  READY
  FAILED
}

enum NarrationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum IllustrationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BookProjectStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum PrintOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum RarityLevel {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum ItemCategory {
  ITEM
  COMPANION
  BADGE
}

enum UxEventName {
  SESSION_STARTED
  AUTH_ERROR_SHOWN
  AUTH_REFRESH_SUCCESS
  AUTH_REFRESH_FAILED
  STORY_CREATE_STARTED
  STORY_CREATE_STEP_COMPLETED
  STORY_CREATE_ABANDONED
  STORY_PUBLISHED
  GAME_HUB_OPENED
  VAULT_STATE_SHOWN
  VAULT_RETRY_TAPPED
  VAULT_EMPTY_CTA_TAPPED
  GAME_STATE_SHOWN
  GAME_RETRY_TAPPED
  GAME_EMPTY_CTA_TAPPED
  POST_PUBLISH_MODAL_OPENED
  POST_PUBLISH_CTA_CLICKED
  PIN_PROMPT_SHOWN
  PIN_PROMPT_SUCCESS
  PIN_PROMPT_ABANDON
  PIN_LOCK_NOW_CLICKED
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  role          UserRole @default(USER)

  passwordHash String?
  imageUrl     String?
  timezone     String   @default("UTC")
  pinHash      String?
  pinUpdatedAt DateTime?
  lastLoginAt  DateTime?

  accounts            Account[]
  sessions            Session[]
  mobileSessions      MobileSession[]
  childProfiles       ChildProfile[]
  storyCollections    StoryCollection[]
  stories             Story[]
  wallet              Wallet?
  walletTransactions  WalletTransaction[]
  userAchievements    UserAchievement[]
  childStreaks        ChildStreak[]
  weeklyMissions      ChildWeeklyMission[]
  gamificationEvents  GamificationEvent[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]
  remoteRoomsOwned    RemoteStoryRoom[]
  storyInteractions   StoryInteraction[]
  createdStoryTemplates StoryTemplate[] @relation("StoryTemplateCreatedBy")
  updatedStoryTemplates StoryTemplate[] @relation("StoryTemplateUpdatedBy")
  createdModerationTerms ModerationTerm[] @relation("ModerationTermCreatedBy")
  updatedModerationTerms ModerationTerm[] @relation("ModerationTermUpdatedBy")
  moderationEvents      ModerationEvent[]
  voiceProfiles         VoiceProfile[]
  bookProjects          BookProject[]
  uxAnalyticsEvents     UxAnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model MobileSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model ChildProfile {
  id             String   @id @default(cuid())
  userId         String
  name           String
  birthDate      DateTime
  avatarUrl      String?
  favoriteThemes String[] @default([])
  isArchived     Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories          Story[]
  storyCollections StoryCollection[]
  inventoryItems   ChildInventoryItem[]
  streak           ChildStreak?
  weeklyMissions   ChildWeeklyMission[]
  avatar           ChildAvatar?
  childInventories ChildInventory[]
  storyMemories    StoryMemory[]
  bookProjects     BookProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isArchived])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  coins     Int      @default(0)
  stars     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String       @id @default(cuid())
  walletId     String
  userId       String
  currencyType CurrencyType
  amount       Int
  reason       WalletReason
  referenceType String?
  referenceId   String?
  balanceAfter Int
  createdAt    DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  iconKey     String
  rewardCoins Int      @default(0)
  rewardStars Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAchievements UserAchievement[]

  @@index([isActive, sortOrder])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  progressValue Int      @default(0)
  metaJson      Json?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model GamificationCatalogItem {
  id          String          @id @default(cuid())
  key         String          @unique
  type        CatalogItemType
  name        String
  description String
  iconKey     String
  priceCoins  Int             @default(0)
  priceStars  Int             @default(0)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  inventoryItems ChildInventoryItem[]

  @@index([type, isActive, sortOrder])
}

model ChildInventoryItem {
  id            String   @id @default(cuid())
  childProfileId String
  itemId        String
  unlockedAt    DateTime @default(now())
  equipped      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  childProfile ChildProfile          @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  item         GamificationCatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, itemId])
  @@index([childProfileId, equipped])
}

model ChildStreak {
  id                   String   @id @default(cuid())
  userId               String
  childProfileId       String   @unique
  currentDays          Int      @default(0)
  bestDays             Int      @default(0)
  lastCountedDate      DateTime?
  shieldCount          Int      @default(0)
  lastShieldGrantWeekKey String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  childProfile ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ChildWeeklyMission {
  id            String       @id @default(cuid())
  userId        String
  childProfileId String
  weekKey       String
  kind          MissionKind
  title         String
  description   String
  targetValue   Int
  progressValue Int          @default(0)
  status        MissionStatus @default(ACTIVE)
  virtueId      String?
  rewardCoins   Int          @default(0)
  rewardStars   Int          @default(0)
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  childProfile ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  virtue       Virtue?     @relation(fields: [virtueId], references: [id], onDelete: SetNull)

  @@index([childProfileId, weekKey, status])
  @@unique([childProfileId, weekKey, kind, virtueId])
}

model GamificationEvent {
  id            String   @id @default(cuid())
  eventKey      String   @unique
  userId        String
  storyId       String?
  childProfileId String?
  processedAt   DateTime @default(now())
  metaJson      Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, processedAt])
  @@index([storyId, processedAt])
}

model StoryCollection {
  id                  String   @id @default(cuid())
  userId              String
  childProfileId      String
  title               String
  theme               String
  virtueId            String?
  isFavorite          Boolean  @default(false)
  templateFromStoryId String?
  lastReferenceAt     DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  childProfile      ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  virtue            Virtue?      @relation(fields: [virtueId], references: [id], onDelete: SetNull)
  templateFromStory Story?       @relation("StoryCollectionTemplateSource", fields: [templateFromStoryId], references: [id], onDelete: SetNull)
  stories           Story[]

  @@index([userId, childProfileId, lastReferenceAt])
  @@index([userId, isFavorite, lastReferenceAt])
  @@index([userId, virtueId, lastReferenceAt])
}

model Story {
  id               String      @id @default(cuid())
  userId           String
  childProfileId   String
  collectionId     String
  sourceTemplateId String?
  artStyleId       String?
  episodeNumber    Int         @default(1)
  continuedFromStoryId String?
  sessionKind      StorySessionKind @default(PRESENTIAL)
  virtueId         String?
  titleDraft       String
  titleFinal       String?
  theme            String
  scenario         String
  objective        String
  ageBand          AgeBand?
  virtueSource     VirtueSource?
  dilemmaText      String?
  endQuestionText  String?
  status           StoryStatus @default(DRAFT)
  currentMode      StoryMode   @default(PARENT_NARRATOR)
  currentStepIndex Int         @default(0)
  ageSnapshotYears Int
  startedAt        DateTime    @default(now())
  publishedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  childProfile        ChildProfile     @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  collection          StoryCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sourceTemplate      StoryTemplate?   @relation("StorySourceTemplate", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  continuedFromStory  Story?           @relation("StoryContinuation", fields: [continuedFromStoryId], references: [id], onDelete: SetNull)
  continuedStories    Story[]          @relation("StoryContinuation")
  templatedCollections StoryCollection[] @relation("StoryCollectionTemplateSource")
  virtue              Virtue?          @relation(fields: [virtueId], references: [id], onDelete: SetNull)
  characters StoryCharacter[]
  steps      StoryStep[]
  ideaLogs   StoryIdeaLog[]
  remoteRoom RemoteStoryRoom?
  interactions StoryInteraction[]
  votes StoryVote[]
  narrationJobs NarrationJob[]
  artStyle            ArtStyle?        @relation(fields: [artStyleId], references: [id], onDelete: SetNull)
  illustrations       StoryIllustration[]
  storyMemories       StoryMemory[]


  @@index([userId, childProfileId, status])
  @@index([collectionId, status, publishedAt, updatedAt])
  @@index([childProfileId, virtueId, status])
  @@index([sourceTemplateId])
  @@unique([collectionId, episodeNumber])
  @@index([updatedAt])
}

model StoryTheme {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  iconKey          String
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prompts   ContentPrompt[]
  templates StoryTemplate[]

  @@index([isActive, sortOrder])
}

model ContentPrompt {
  id        String     @id @default(cuid())
  key       String     @unique
  kind      PromptKind
  title     String
  text      String
  themeId   String?
  virtueId  String?
  ageBand   AgeBand?
  mode      StoryMode?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  theme  StoryTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)
  virtue Virtue?     @relation(fields: [virtueId], references: [id], onDelete: SetNull)

  @@index([kind, isActive, sortOrder])
  @@index([themeId, virtueId, ageBand, mode])
}

model StoryTemplate {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  description      String
  themeId          String?
  virtueId         String?
  ageBand          AgeBand?
  defaultScenario  String
  defaultObjective String
  isActive         Boolean  @default(true)
  isPublished      Boolean  @default(false)
  version          Int      @default(1)
  createdByUserId  String
  updatedByUserId  String
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  theme      StoryTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)
  virtue     Virtue?     @relation(fields: [virtueId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("StoryTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy  User        @relation("StoryTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  stories    Story[]     @relation("StorySourceTemplate")
  characters StoryTemplateCharacter[]
  nodes      StoryTemplateNode[]

  @@index([isPublished, isActive, updatedAt])
  @@index([themeId, virtueId, ageBand])
}

model StoryTemplateCharacter {
  id        String   @id @default(cuid())
  templateId String
  name      String
  role      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template StoryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

model StoryTemplateNode {
  id          String               @id @default(cuid())
  templateId  String
  nodeKey     String
  kind        StoryTemplateNodeKind
  title       String
  narratorText String?
  promptHint  String?
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  template       StoryTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  options        StoryTemplateOption[] @relation("StoryTemplateNodeOptions")
  incomingOptions StoryTemplateOption[] @relation("StoryTemplateNodeNext")

  @@unique([templateId, nodeKey])
  @@index([templateId, sortOrder])
}

model StoryTemplateOption {
  id        String   @id @default(cuid())
  nodeId    String
  optionKey String
  label     String
  nextNodeId String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  node     StoryTemplateNode @relation("StoryTemplateNodeOptions", fields: [nodeId], references: [id], onDelete: Cascade)
  nextNode StoryTemplateNode @relation("StoryTemplateNodeNext", fields: [nextNodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, optionKey])
  @@index([nodeId, sortOrder])
  @@index([nextNodeId])
}

model ModerationTerm {
  id              String           @id @default(cuid())
  termNormalized  String           @unique
  displayTerm     String
  policy          ModerationPolicy
  replacement     String?
  scope           ModerationScope
  isActive        Boolean          @default(true)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy User @relation("ModerationTermCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy User @relation("ModerationTermUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([scope, isActive])
}

model ModerationEvent {
  id             String           @id @default(cuid())
  userId         String?
  scope          ModerationScope
  field          String
  originalPreview String
  action         ModerationAction
  matchedTerm    String
  createdAt      DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([scope, createdAt])
  @@index([userId, createdAt])
}

model RemoteStoryRoom {
  id                 String            @id @default(cuid())
  storyId            String            @unique
  ownerUserId        String
  status             RemoteRoomStatus  @default(OPEN)
  joinCodeHash       String
  joinCodeExpiresAt  DateTime
  joinCodeConsumedAt DateTime?
  callMode           CallMode          @default(AUDIO)
  maxParticipants    Int               @default(2)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  closedAt           DateTime?

  story        Story                   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  owner        User                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  participants RemoteStoryParticipant[]
  interactions StoryInteraction[]

  @@index([ownerUserId, status])
  @@index([joinCodeExpiresAt])
}

model RemoteStoryParticipant {
  id             String                  @id @default(cuid())
  remoteRoomId   String
  role           RemoteParticipantRole
  displayName    String
  status         RemoteParticipantStatus @default(CONNECTED)
  lastSeenAt     DateTime                @default(now())
  joinedAt       DateTime                @default(now())
  leftAt         DateTime?
  deviceInfo     String?

  remoteRoom    RemoteStoryRoom          @relation(fields: [remoteRoomId], references: [id], onDelete: Cascade)
  interactions  StoryInteraction[]
  votes         StoryVote[]

  @@unique([remoteRoomId, role])
  @@index([remoteRoomId, status])
}

model Virtue {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  iconKey          String
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  templates        VirtueTemplate[]
  contentPrompts   ContentPrompt[]
  storyTemplates   StoryTemplate[]
  stories          Story[]
  storyCollections StoryCollection[]
  weeklyMissions   ChildWeeklyMission[]

  @@index([isActive, sortOrder])
}

model VirtueTemplate {
  id            String   @id @default(cuid())
  virtueId      String
  ageBand       AgeBand
  dilemmaText   String
  endQuestionText String
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  virtue Virtue @relation(fields: [virtueId], references: [id], onDelete: Cascade)

  @@index([virtueId, ageBand, isActive])
  @@unique([virtueId, ageBand, sortOrder])
}

model StoryCharacter {
  id        String   @id @default(cuid())
  storyId   String
  name      String
  role      String?
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
}

model StoryStep {
  id                  String       @id @default(cuid())
  storyId             String
  stepIndex           Int
  kind                StoryStepKind
  modeUsed            StoryMode
  localEventId        String
  narratorPrompt      String?
  childOptionsJson    Json?
  selectedOptionId    String?
  selectedOptionLabel String?
  narratorText        String?
  autoSavedAt         DateTime     @default(now())
  createdAt           DateTime     @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, stepIndex])
  @@index([storyId, localEventId])
  @@index([storyId, createdAt])
}

model StoryIdeaLog {
  id             String   @id @default(cuid())
  storyId        String
  stepIndex      Int?
  source         String
  safetyAdjusted Boolean  @default(false)
  promptInput    String?
  ideasJson      Json
  fallbackReason String?
  createdAt      DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
}

model StoryVote {
  id             String                 @id @default(cuid())
  storyId        String
  stepIndex      Int
  participantId  String
  optionId       String
  optionLabel    String
  createdAt      DateTime               @default(now())

  story       Story                  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  participant RemoteStoryParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([storyId, stepIndex, participantId])
  @@index([storyId, stepIndex])
}

model StoryInteraction {
  id                 String                 @id @default(cuid())
  storyId            String
  remoteRoomId       String
  type               InteractionType
  authorRole         RemoteParticipantRole
  authorUserId       String?
  authorParticipantId String?
  authorDisplayName  String
  messageText        String?
  emoji              String?
  createdAt          DateTime               @default(now())

  story             Story                   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  remoteRoom        RemoteStoryRoom         @relation(fields: [remoteRoomId], references: [id], onDelete: Cascade)
  authorUser        User?                   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorParticipant RemoteStoryParticipant? @relation(fields: [authorParticipantId], references: [id], onDelete: SetNull)

  @@index([storyId, createdAt])
  @@index([remoteRoomId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model AuditEvent {
  id        String  @id @default(cuid())
  userId    String?
  action    String
  meta      Json?
  ipAddress String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, action])
  @@index([createdAt])
}

model UxAnalyticsEvent {
  id              String      @id @default(cuid())
  eventId         String      @unique
  eventName       UxEventName
  appSessionId    String
  userId          String?
  mobileSessionId String?
  childHash       String?
  occurredAt      DateTime
  receivedAt      DateTime    @default(now())
  source          String?
  params          Json?
  platform        String?
  appVersion      String?
  appBuild        String?
  locale          String?
  timezone        String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName, occurredAt])
  @@index([appSessionId, occurredAt])
  @@index([userId, occurredAt])
  @@index([mobileSessionId, occurredAt])
  @@index([childHash, occurredAt])
}

model VoiceProfile {
  id           String             @id @default(cuid())
  userId       String
  name         String
  relationship String?
  status       VoiceProfileStatus @default(PENDING)
  provider     String?
  metadataJson Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  samples      VoiceSample[]
  jobs         NarrationJob[]

  @@index([userId, status])
}

model VoiceSample {
  id             String       @id @default(cuid())
  voiceProfileId String
  storageUrl     String
  duration       Float?
  transcript     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  profile        VoiceProfile @relation(fields: [voiceProfileId], references: [id], onDelete: Cascade)

  @@index([voiceProfileId])
}

model NarrationJob {
  id             String             @id @default(cuid())
  storyId        String
  stepIndex      Int?
  voiceProfileId String
  status         NarrationJobStatus @default(PENDING)
  outputUrl      String?
  metadataJson   Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  story          Story              @relation(fields: [storyId], references: [id], onDelete: Cascade)
  voiceProfile   VoiceProfile       @relation(fields: [voiceProfileId], references: [id], onDelete: Cascade)

  @@index([storyId, status])
  @@index([voiceProfileId, status])
}

model ArtStyle {
  id             String    @id @default(cuid())
  name           String
  promptTemplate String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stories Story[]
}

model ChildAvatar {
  id             String       @id @default(cuid())
  childProfileId String       @unique
  status         String?
  photoUrl       String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  childProfile ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
}

model StoryIllustration {
  id         String             @id @default(cuid())
  storyId    String
  stepIndex  Int
  status     IllustrationStatus @default(PENDING)
  promptUsed String?
  imageUrl   String?
  provider   String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, stepIndex])
}

model InventoryItem {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  description String
  rarity      RarityLevel  @default(COMMON)
  category    ItemCategory @default(ITEM)
  icon        String
  tags        String[]

  childInventories ChildInventory[]
}

model ChildInventory {
  id             String   @id @default(cuid())
  childProfileId String
  itemId         String
  qty            Int      @default(1)
  acquiredAt     DateTime @default(now())
  lastUsedAt     DateTime?

  childProfile ChildProfile  @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, itemId])
}

model StoryMemory {
  id             String   @id @default(cuid())
  storyId        String
  childProfileId String
  summary        String
  usedItems      String[]
  virtueLearned  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  story          Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  childProfile   ChildProfile  @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([storyId, childProfileId])
}

model BookProject {
  id             String            @id @default(cuid())
  userId         String
  childProfileId String
  month          String
  title          String
  status         BookProjectStatus @default(DRAFT)
  pdfUrl         String?
  includedStories String[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  childProfile   ChildProfile      @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  printOrders    PrintOrder[]

  @@unique([childProfileId, month])
}

model PrintOrder {
  id              String            @id @default(cuid())
  bookProjectId   String
  provider        String?
  status          PrintOrderStatus  @default(PENDING)
  trackingCode    String?
  addressSnapshot Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  bookProject     BookProject       @relation(fields: [bookProjectId], references: [id], onDelete: Cascade)

  @@index([bookProjectId, status])
}
